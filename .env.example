# ==============================================================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE - IDOMED FAMEJIPA QUIZ
# ==============================================================================
# Renomeie este arquivo para .env.local em ambiente de desenvolvimento.
# Na Vercel, cadastre estas chaves em: Settings > Environment Variables.
# NUNCA versione chaves secretas ou credenciais com privilégios de serviço.
# ==============================================================================

# URL base do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anônima (segura para navegadores e clientes públicos)
SUPABASE_ANON_KEY=sua-chave-publica-anon-aqui

# Chave de serviço (OPCIONAL - somente backend/Vercel serverless, NUNCA no frontend)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
